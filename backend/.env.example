# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
# Leave blank to automatically use MongoDB In-Memory database for local zero-config testing!
MONGODB_URI=

# JWT Secret for Demo/Fallback Authentication
JWT_SECRET=nomadly_super_secret_jwt_key_2026_travel_platform

# Firebase Admin SDK Configuration (Optional - Demo mode works automatically if empty)
# Get from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Razorpay Test Mode Credentials (Optional - Mock payment sandbox works automatically if empty)
# Get from Razorpay Dashboard -> Settings -> API Keys (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# External Flight/Hotel Provider APIs (Optional - Simulated realistic provider data included)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
RAPIDAPI_KEY=
