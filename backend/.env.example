# ==============================================================================
# NOMADLY TRAVEL PLATFORM - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env in local development: cp .env.example .env
# ==============================================================================

# Server & Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
# Leave blank to automatically spin up high-performance in-memory MongoDB for zero-config testing!
# Production: mongodb+srv://<user>:<password>@cluster.mongodb.net/nomadly?retryWrites=true&w=majority
MONGODB_URI=

# Authentication Security
# Mandatory in production. Minimum 32-character high-entropy secret string.
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# Firebase Admin SDK Credentials (Optional for local development; enables live Google OAuth & ID Token verification)
# Download from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Payment Gateway (Optional - Simulated verified sandbox checkout runs automatically if blank)
# Test credentials from Razorpay Dashboard -> Settings -> API Keys (Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email Dispatch & Relay Configuration
# Option A: Netlify Serverless Gmail Relay (HTTPS Port 443 - Bypasses cloud host SMTP port blocks)
NETLIFY_EMAIL_URL=https://nomadly-travel.netlify.app/.netlify/functions/send-email

# Option B: Resend HTTPS API (Port 443)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Nomadly Travel <onboarding@resend.dev>

# Option C: Direct Nodemailer SMTP (Standard ports 587 or 465)
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# External Supplier Integrations (Optional - Curated realistic supplier inventory fallback included)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
RAPIDAPI_KEY=
