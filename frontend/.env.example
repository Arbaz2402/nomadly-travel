# ==============================================================================
# NOMADLY TRAVEL PLATFORM - FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env in local development: cp .env.example .env
# ==============================================================================

# Backend API Endpoint (e.g. http://localhost:5000/api/v1 or https://nomadly-travel.onrender.com/api/v1)
VITE_API_URL=http://localhost:5000/api/v1

# Firebase Client Web SDK Configuration (Obtain from Firebase Console -> Project Settings -> General -> Web App)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Razorpay Client Public Key ID (Test key from Razorpay Dashboard, e.g. rzp_test_xxx)
VITE_RAZORPAY_KEY_ID=
